{
  "runtime_configs": [
    {
      "name": "shapes-min",
      "config": {
        "name": "shapes-min",
        "model": {
          "id": "test/model",
          "provider": "openrouter"
        },
        "limits": {
          "max_steps_per_task": 60,
          "max_cost_per_task_usd": 1
        },
        "models": {},
        "mcp_servers": {},
        "permissions": {
          "computer.exec": "allow",
          "computer.screenshot": "allow",
          "files.read": "allow",
          "files.write": "allow",
          "browser.identity.list": "allow",
          "browser.identity.create": "allow",
          "browser.identity.delete": "ask",
          "browser.identity.launch": "allow",
          "browser.identity.close": "allow",
          "browser.navigate": "allow",
          "browser.read": "allow",
          "browser.act": "allow",
          "automations": "ask"
        }
      }
    },
    {
      "name": "shapes-full",
      "config": {
        "name": "shapes-full",
        "model": {
          "id": "test/model",
          "provider": "openrouter"
        },
        "limits": {
          "max_steps_per_task": 30,
          "max_cost_per_task_usd": 2.5
        },
        "models": {
          "summary": "test/small"
        },
        "mcp_servers": {
          "time": {
            "env": {
              "LOG_LEVEL": "warning"
            },
            "args": [
              "mcp-server-time",
              "--local-timezone",
              "Europe/Rome"
            ],
            "command": "uvx",
            "secrets": [
              "TIME_TOKEN"
            ],
            "timeout_s": 120
          },
          "search": {
            "url": "https://search.example/mcp",
            "headers": {
              "X-Client": "dots"
            },
            "secrets": [
              "Authorization"
            ],
            "timeout_s": 30
          }
        },
        "permissions": {
          "computer.exec": "deny",
          "computer.screenshot": "allow",
          "files.read": "allow",
          "files.write": "ask",
          "browser.identity.list": "allow",
          "browser.identity.create": "allow",
          "browser.identity.delete": "ask",
          "browser.identity.launch": "allow",
          "browser.identity.close": "allow",
          "browser.navigate": "allow",
          "browser.read": "allow",
          "browser.act": "allow",
          "automations": "ask",
          "mcp.time": "allow",
          "mcp.search": "ask"
        },
        "instructions": "Answer in one line."
      }
    }
  ],
  "secrets_requests": [
    {
      "openrouter_api_key": "sk-or-test",
      "mcp_secrets": {
        "time": {
          "TIME_TOKEN": "tt-1"
        },
        "search": {
          "Authorization": "Bearer sk-search-1"
        }
      }
    }
  ],
  "inbound_events": [
    {
      "type": "user.message",
      "data": {
        "text": "what is the cheapest fare to Lisbon?"
      }
    },
    {
      "type": "task.created",
      "data": {
        "task_id": "task-1",
        "priority": 5,
        "description": "compare the fares"
      }
    },
    {
      "type": "system.event",
      "data": {
        "data": {
          "task_id": "task-1"
        },
        "name": "task.cancelled"
      }
    },
    {
      "type": "task.created",
      "data": {
        "task_id": "task-2",
        "priority": 0,
        "description": "a task with the default priority"
      }
    },
    {
      "type": "approval.received",
      "data": {
        "note": "go on",
        "decision": "approve",
        "approval_id": "approval-1"
      }
    },
    {
      "type": "approval.received",
      "data": {
        "decision": "reject",
        "approval_id": "approval-2"
      }
    }
  ]
}
